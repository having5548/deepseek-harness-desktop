{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "主窗口与辅助窗口（日志/插件/设置）的默认能力：自定义命令 + 事件监听",
  "windows": ["main", "logs", "plugins", "settings"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-set-title"
  ]
}
